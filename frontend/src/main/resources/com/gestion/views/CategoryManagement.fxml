<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/27"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestion.controller.CategoryManagementController"
      spacing="24"
      prefWidth="950"
      prefHeight="620"
      minWidth="650"
      minHeight="450"
      styleClass="products-page">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <!-- En-tête -->
    <VBox spacing="7">
        <Label text="Gestion des catégories"
               styleClass="page-title"/>

        <Label text="Organisez et gérez les catégories de vos produits."
               styleClass="page-subtitle"/>
    </VBox>

    <!-- Barre d'actions -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="5">
            <Label text="Liste des catégories"
                   styleClass="section-title"/>

            <Label text="Consultez et gérez vos catégories."
                   styleClass="page-subtitle"/>
        </VBox>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="+ Ajouter une catégorie"
                onAction="#addCategory"
                styleClass="primary-button"/>
    </HBox>

    <!-- Tableau -->
    <TableView fx:id="categoriesTable"
               VBox.vgrow="ALWAYS"
               minHeight="200">

        <placeholder>
            <Label text="Aucune catégorie disponible."
                   styleClass="page-subtitle"/>
        </placeholder>

        <columns>

            <TableColumn fx:id="idColumn"
                         text="ID"
                         minWidth="55"
                         prefWidth="70"/>

            <TableColumn fx:id="nameColumn"
                         text="Nom de la catégorie"
                         minWidth="150"
                         prefWidth="230"/>

            <TableColumn fx:id="descriptionColumn"
                         text="Description"
                         minWidth="150"
                         prefWidth="280"/>

            <TableColumn fx:id="actionsColumn"
                         text="Actions"
                         minWidth="160"
                         prefWidth="190"/>

        </columns>
    </TableView>

</VBox>