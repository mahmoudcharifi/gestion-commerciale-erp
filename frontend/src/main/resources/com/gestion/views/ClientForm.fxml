<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>

<VBox xmlns="http://javafx.com/javafx/27"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestion.controller.ClientFormController"
      spacing="15"
      prefWidth="520"
      style="-fx-padding: 25; -fx-background-color: white;">

    <Label fx:id="formTitle"
           text="Nouveau client"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <Label text="Renseignez les informations du client."
           style="-fx-text-fill: #777777;"/>

    <!-- TYPE DE CLIENT -->
    <VBox spacing="6">
        <Label text="Type de client"/>
        <ComboBox fx:id="typeClientComboBox"
                  promptText="Choisir le type de client"
                  maxWidth="Infinity"/>
    </VBox>

    <!-- INFORMATIONS PARTICULIER -->
    <VBox fx:id="particulierSection" spacing="12">

        <Label text="Informations personnelles"
               style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

        <GridPane hgap="12" vgap="12">

            <Label text="Nom :" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="nomField"
                       promptText="Nom de famille"
                       GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Prénom :" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="prenomField"
                       promptText="Prénom"
                       GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        </GridPane>
    </VBox>

    <!-- INFORMATIONS ENTREPRISE -->
    <VBox fx:id="entrepriseSection" spacing="12" visible="false" managed="false">

        <Label text="Informations professionnelles"
               style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

        <GridPane hgap="12" vgap="12">

            <Label text="Raison sociale :" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="raisonSocialeField"
                       promptText="Nom de l'entreprise"
                       GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="ICE :" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="iceField"
                       promptText="ICE"
                       GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="IF :" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="identifiantFiscalField"
                       promptText="Identifiant fiscal"
                       GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="RC :" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <TextField fx:id="registreCommerceField"
                       promptText="Registre de commerce"
                       GridPane.columnIndex="1" GridPane.rowIndex="3"/>

            <Label text="Contact :" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <TextField fx:id="personneContactField"
                       promptText="Personne à contacter"
                       GridPane.columnIndex="1" GridPane.rowIndex="4"/>

        </GridPane>
    </VBox>

    <!-- COORDONNEES COMMUNES -->
    <VBox spacing="12">

        <Label text="Coordonnées"
               style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

        <GridPane hgap="12" vgap="12">

            <Label text="Téléphone :" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="telephoneField"
                       promptText="Téléphone"
                       GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Email :" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="emailField"
                       promptText="Adresse email"
                       GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Adresse :" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="adresseField"
                       promptText="Adresse"
                       GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="Ville :" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <TextField fx:id="villeField"
                       promptText="Ville"
                       GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        </GridPane>
    </VBox>

    <Label fx:id="errorLabel"
           wrapText="true"
           style="-fx-text-fill: #DC2626;"/>

    <HBox spacing="10">
        <Button text="Annuler"
                onAction="#cancelForm"
                maxWidth="Infinity"
                HBox.hgrow="ALWAYS"
                style="-fx-padding: 12;"/>

        <Button text="Enregistrer le client"
                onAction="#saveClient"
                maxWidth="Infinity"
                HBox.hgrow="ALWAYS"
                style="-fx-background-color: #07574F;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;
                       -fx-padding: 12;"/>
    </HBox>

</VBox>
