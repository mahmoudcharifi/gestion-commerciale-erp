<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>

<ScrollPane xmlns="http://javafx.com/javafx/27"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.gestion.controller.ClientsController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            vbarPolicy="AS_NEEDED"
            styleClass="products-scroll">

    <content>
        <VBox spacing="20" styleClass="products-page">

            <!-- TITRE -->
            <VBox spacing="8">
                <Label text="Gestion des clients"
                       styleClass="page-title"/>

                <Label text="Gérez les particuliers et les entreprises enregistrés dans votre système."
                       styleClass="page-subtitle"/>
            </VBox>

            <!-- STATISTIQUES -->
            <GridPane hgap="15" vgap="15">

                <VBox GridPane.columnIndex="0"
                      GridPane.rowIndex="0"
                      spacing="10"
                      styleClass="card">

                    <Label text="Total des clients"
                           styleClass="secondary-text"/>

                    <Label fx:id="totalClientsLabel"
                           text="0"
                           styleClass="stat-value"/>
                </VBox>

                <VBox GridPane.columnIndex="1"
                      GridPane.rowIndex="0"
                      spacing="10"
                      styleClass="card">

                    <Label text="Particuliers"
                           styleClass="secondary-text"/>

                    <Label fx:id="particuliersLabel"
                           text="0"
                           styleClass="stat-value"/>
                </VBox>

                <VBox GridPane.columnIndex="2"
                      GridPane.rowIndex="0"
                      spacing="10"
                      styleClass="card">

                    <Label text="Entreprises"
                           styleClass="secondary-text"/>

                    <Label fx:id="entreprisesLabel"
                           text="0"
                           styleClass="stat-value"/>
                </VBox>

            </GridPane>

            <!-- LISTE DES CLIENTS -->
            <VBox spacing="15">

                <Label text="Liste des clients"
                       styleClass="section-title"/>

                <!-- RECHERCHE ET FILTRE -->
                <HBox spacing="12" alignment="CENTER_LEFT">

                    <TextField fx:id="searchField"
                               promptText="Rechercher par nom, code, téléphone..."
                               prefHeight="40"
                               HBox.hgrow="ALWAYS"/>

                    <ComboBox fx:id="typeFilterComboBox"
                              promptText="Tous les types"
                              prefWidth="170"
                              prefHeight="40"/>

                    <Button text="+ Nouveau client"
                            onAction="#openClientForm"
                            styleClass="button, primary-button"/>

                </HBox>

                <!-- TABLEAU -->
                <TableView fx:id="clientsTable"
                           styleClass="products-table">

                    <columns>

                        <TableColumn fx:id="codeColumn"
                                     text="Code client"
                                     prefWidth="110"/>

                        <TableColumn fx:id="nameColumn"
                                     text="Nom / Raison sociale"
                                     prefWidth="190"/>

                        <TableColumn fx:id="typeColumn"
                                     text="Type"
                                     prefWidth="120"/>

                        <TableColumn fx:id="phoneColumn"
                                     text="Téléphone"
                                     prefWidth="135"/>

                        <TableColumn fx:id="emailColumn"
                                     text="Email"
                                     prefWidth="180"/>

                        <TableColumn fx:id="cityColumn"
                                     text="Ville"
                                     prefWidth="110"/>

                        <TableColumn fx:id="actionsColumn"
                                     text="Actions"
                                     prefWidth="160"
                                     sortable="false"
                                     resizable="false"/>

                    </columns>

                </TableView>

            </VBox>

        </VBox>
    </content>

</ScrollPane>
