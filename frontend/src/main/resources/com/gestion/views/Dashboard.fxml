<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>

<VBox xmlns="http://javafx.com/javafx/27"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestion.controller.DashboardController"
      spacing="22"
      styleClass="dashboard-page">

    <VBox spacing="7">
        <Label text="Tableau de bord"
               styleClass="page-title"/>

        <Label text="Bienvenue dans votre espace de gestion commerciale."
               styleClass="page-subtitle"/>
    </VBox>

    <GridPane hgap="15" vgap="15">

        <VBox GridPane.columnIndex="0"
              GridPane.rowIndex="0"
              spacing="12"
              styleClass="card">

            <Label text="Chiffre d'affaires"
                   styleClass="secondary-text"/>

            <Label fx:id="chiffreAffairesLabel"
                   text="0,00 MAD"
                   styleClass="dashboard-stat-value"/>

            <Label text="Total des ventes validées"
                   styleClass="secondary-text"/>
        </VBox>

        <VBox GridPane.columnIndex="1"
              GridPane.rowIndex="0"
              spacing="12"
              styleClass="card">

            <Label text="Produits"
                   styleClass="secondary-text"/>

            <Label fx:id="totalProduitsLabel"
                   text="0"
                   styleClass="dashboard-stat-value"/>

            <Label text="Produits enregistrés"
                   styleClass="secondary-text"/>
        </VBox>

        <VBox GridPane.columnIndex="2"
              GridPane.rowIndex="0"
              spacing="12"
              styleClass="card">

            <Label text="Clients"
                   styleClass="secondary-text"/>

            <Label fx:id="totalClientsLabel"
                   text="0"
                   styleClass="dashboard-stat-value"/>

            <Label text="Clients enregistrés"
                   styleClass="secondary-text"/>
        </VBox>

        <VBox GridPane.columnIndex="3"
              GridPane.rowIndex="0"
              spacing="12"
              styleClass="card">

            <Label text="Stock faible"
                   styleClass="secondary-text"/>

            <Label fx:id="stockFaibleLabel"
                   text="0"
                   styleClass="dashboard-stat-value"/>

            <Label text="Produits à réapprovisionner"
                   styleClass="secondary-text"/>
        </VBox>

    </GridPane>

    <VBox spacing="15">
        <Label text="Activité récente"
               styleClass="section-title"/>

        <VBox spacing="12" styleClass="card">

            <TableView fx:id="activiteTable"
                       styleClass="products-table">

                <columns>
                    <TableColumn fx:id="referenceColumn"
                                 text="Référence"
                                 prefWidth="130"/>

                    <TableColumn fx:id="clientColumn"
                                 text="Client"
                                 prefWidth="180"/>

                    <TableColumn fx:id="dateColumn"
                                 text="Date"
                                 prefWidth="150"/>

                    <TableColumn fx:id="montantColumn"
                                 text="Montant TTC"
                                 prefWidth="140"/>

                    <TableColumn fx:id="statutColumn"
                                 text="Statut"
                                 prefWidth="130"/>
                </columns>

                <placeholder>
                    <Label text="Aucune activité récente pour le moment."
                           styleClass="secondary-text"/>
                </placeholder>

            </TableView>

        </VBox>
    </VBox>

</VBox>
