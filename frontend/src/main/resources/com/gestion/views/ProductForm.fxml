<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Button?>

<VBox xmlns="http://javafx.com/javafx/27"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestion.controller.ProductFormController"
      spacing="15"
      prefWidth="450"
      style="-fx-padding: 25; -fx-background-color: white;">

    <Label text="Ajouter un produit"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <Label text="Veuillez renseigner les informations du produit."
           style="-fx-text-fill: #777777;"/>

    <GridPane hgap="12" vgap="12">

        <Label text="Référence :"
               GridPane.columnIndex="0"
               GridPane.rowIndex="0"/>

        <TextField fx:id="referenceField"
                   promptText="Ex : PRD-004"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="0"/>

        <Label text="Nom :"
               GridPane.columnIndex="0"
               GridPane.rowIndex="1"/>

        <TextField fx:id="nameField"
                   promptText="Nom du produit"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="1"/>

        <Label text="Catégorie :"
               GridPane.columnIndex="0"
               GridPane.rowIndex="2"/>

        <ComboBox fx:id="categoryComboBox"
                  promptText="Choisir une catégorie"
                  maxWidth="Infinity"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="2"/>

        <Label text="Prix (MAD) :"
               GridPane.columnIndex="0"
               GridPane.rowIndex="3"/>

        <TextField fx:id="priceField"
                   promptText="Ex : 1800.00"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="3"/>

        <Label text="Quantité :"
               GridPane.columnIndex="0"
               GridPane.rowIndex="4"/>

        <TextField fx:id="quantityField"
                   promptText="Ex : 15"
                   GridPane.columnIndex="1"
                   GridPane.rowIndex="4"/>

    </GridPane>

    <Label fx:id="errorLabel"
           wrapText="true"
           style="-fx-text-fill: #DC2626;"/>

    <Button text="Enregistrer le produit"
            maxWidth="Infinity"
            onAction="#saveProduct"
            style="-fx-background-color: #07574F;
                   -fx-text-fill: white;
                   -fx-font-weight: bold;
                   -fx-padding: 12;"/>

</VBox>